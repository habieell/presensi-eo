APP_NAME="Presensi TSX"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:3000,localhost:8000
SESSION_DOMAIN=localhost

# ==================================================================
# NOTIFICATION CHANNELS
# ==================================================================

# ─── TELEGRAM (RECOMMENDED — gratis, stable) ───────────────────────
# 1) Chat @BotFather di Telegram → /newbot → ikuti instruksi → dapat TOKEN
# 2) Chat dulu sama bot lu (kirim /start)
# 3) Buka https://api.telegram.org/bot<TOKEN>/getUpdates → cari "chat":{"id": ...}
TELEGRAM_NOTIFICATION_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=

# ─── WHATSAPP via Fonnte (OPTIONAL — berbayar) ──────────────────────
# Default OFF. Set true kalau lu udah punya akun Fonnte berbayar.
WHATSAPP_NOTIFICATION_ENABLED=false
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
FONNTE_DEVICE=
FONNTE_COUNTRY_CODE=62
ADMIN_WA_NUMBERS=

# ==================================================================
# FACE RECOGNITION
# ==================================================================
FACE_RECOGNITION_ENABLED=true
FACE_MATCH_THRESHOLD=0.55
FACE_MIN_DETECTION_CONFIDENCE=0.7

# ==================================================================
# CAPTCHA
# ==================================================================
CAPTCHA_ENABLED=true
CAPTCHA_SENSITIVE=true

VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}/api"
